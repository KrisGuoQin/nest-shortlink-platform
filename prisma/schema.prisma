// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  name         String?
  passwordHash String

  sessions AuthSession[]
  workspaceMemberships WorkspaceMember[]
  createdLinks ShortLink[] @relation("ShortLinkCreator")
  sharedLinks ShortLinkShareUser[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthSession {
  id     String @id
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String
  version          Int       @default(0)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id String @id @default(uuid())
  code String @unique
  name String
  members WorkspaceMemberRole[]
  permissions RolePermission[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Permission {
  id String @id @default(uuid())
  code String @unique
  name String
  roles RolePermission[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model RolePermission {
  roleId String
  permissionId String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt        DateTime  @default(now())

  // 复合主键，组合只能存在一次
  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Workspace {
  id String @id @default(uuid())
  name String
  slug String @unique

  members WorkspaceMember[]
  shortLinks ShortLink[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model WorkspaceMember {
  id String @id @default(uuid())

  workspaceId String
  userId String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  roles WorkspaceMemberRole[]

  joinedAt DateTime @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceMemberRole {
  memberId String
  roleId String

  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime  @default(now())
  
  @@id([memberId, roleId])
  @@index([roleId])
}

enum ShortLinkStatus {
  ACTIVE
  DISABLED
}

enum ShortLinkVisibility {
  PUBLIC
  WORKSPACE
  PRIVATE
  PASSWORD
}

model ShortLink {
  id String @id @default(uuid())

  workspaceId String
  createdById String
  
  code String @unique @db.VarChar(16)
  originalUrl String @db.Text
  title String? @db.VarChar(200)
  visibility ShortLinkVisibility @default(PUBLIC)
  status ShortLinkStatus @default(ACTIVE)

  expiresAt DateTime?
  maxVisits Int?
  visitCount Int @default(0)
  // PASSWORD模式使用
  passwordHash String?
  // 分享策略版本
  // 修改密码/访问策略时递增
  accessVersion Int @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User @relation("ShortLinkCreator", fields: [createdById], references: [id])
  sharedUsers ShortLinkShareUser[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@index([createdById])
}

model ShortLinkShareUser {
  shortLinkId String
  userId String

  shortLink ShortLink @relation(fields: [shortLinkId],references: [id], onDelete: Cascade)
  user User @relation(fields: [userId],references: [id], onDelete: Cascade)
  
  createdAt        DateTime  @default(now())
  @@id([shortLinkId, userId])
  @@index([userId])
}

// 访问事件
model ShortLinkVisit {
  eventId String @id

  shortLinkId String

  workspaceId String

  shortCode String @db.VarChar(16)

  visitedAt DateTime

  ipHash String? @db.VarChar(64)

  userAgent String? @db.VarChar(512)

  referer String? @db.Text

  ingestedAt DateTime @default(now())

  @@index([shortLinkId, visitedAt])

  @@index([workspaceId, visitedAt])

  @@index([visitedAt])
}

// 记录：谁，在什么时候，对什么资源，做了什么事
model AuditLog {
  id String @id @default(uuid())

  eventId String @unique

  workspaceId String?

  actorUserId String?

  action String @db.VarChar(100)

  resourceType String @db.VarChar(100)

  resourceId String?

  requestId String? @db.VarChar(100)

  metadata Json?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  DEAD
}

// 还有什么事件需要可靠投递出去
model OutboxEvent {
  id String @id

  eventType String @db.VarChar(150)

  aggregateType String @db.VarChar(100)

  aggregateId String?

  payload Json

  status OutboxStatus @default(PENDING)

  attempts Int @default(0)

  nextAttemptAt DateTime @default(now())

  lockedAt DateTime?

  lockedBy String? @db.VarChar(100)

  publishedAt DateTime?

  lastError String? @db.Text

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([status,nextAttemptAt,createdAt])
}