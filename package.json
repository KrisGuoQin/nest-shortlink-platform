{
  "name": "nest-shortlink-platform",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "OTEL_SERVICE_NAME=shortlink-api nest start --exec 'node --import ./dist/telemetry/instrumentation.js'",
    "start:dev": "OTEL_SERVICE_NAME=shortlink-api nest start --watch --exec 'node --import ./dist/telemetry/instrumentation.js'",
    "start:debug": "OTEL_SERVICE_NAME=shortlink-api nest start --debug --watch --exec 'node --import ./dist/telemetry/instrumentation.js'",
    "start:prod": "OTEL_SERVICE_NAME=shortlink-api node --import=./dist/telemetry/instrumentation.js ./dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "seed:rbac": "tsx scripts/seed-rbac.ts",
    "start:worker": "OTEL_SERVICE_NAME=analytics-worker nest start --entryFile analytics-worker/main --tsc --exec 'node --import ./dist/telemetry/instrumentation.js'",
    "start:worker:dev": "OTEL_SERVICE_NAME=analytics-worker nest start --entryFile analytics-worker/main --watch --tsc --exec 'node --import ./dist/telemetry/instrumentation.js'",
    "start:worker:prod": "OTEL_SERVICE_NAME=analytics-worker node --import=./dist/telemetry/instrumentation.js ./dist/analytics-worker/main.js",
    "start:outbox": "OTEL_SERVICE_NAME=outbox-worker nest start --entryFile outbox-worker/main --tsc --exec 'node --import ./dist/telemetry/instrumentation.js'",
    "start:outbox:dev": "OTEL_SERVICE_NAME=outbox-worker nest start --entryFile outbox-worker/main --watch --tsc --exec 'node --import ./dist/telemetry/instrumentation.js'",
    "start:outbox:prod": "OTEL_SERVICE_NAME=outbox-worker node --import=./dist/telemetry/instrumentation.js ./dist/outbox-worker/main.js",
    "start:otel": "pnpm run start",
    "start:worker:otel": "pnpm run start:worker",
    "start:outbox:otel": "pnpm run start:outbox"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "^12.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prometheus-io/client": "^0.16.1",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "autocannon": "^8.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
