# Copy to .env.production; this file is BOTH Compose input and container env.
# Replace every CHANGE_ME value. Keep credentials URL-safe (openssl rand -hex 32).
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://shortlink:${POSTGRES_PASSWORD}@postgres:5432/shortlink?schema=public
REDIS_URL=redis://redis:6379
REDIS_CLUSTER_NODES=redis-cluster:7100,redis-cluster:7101,redis-cluster:7102
RABBITMQ_URL=amqp://shortlink:${RABBITMQ_PASSWORD}@rabbitmq:5672
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
JWT_SECRET=CHANGE_ME_JWT
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH
SHARE_ACCESS_SECRET=CHANGE_ME_SHARE
ANALYTICS_IP_HASH_SECRET=CHANGE_ME_ANALYTICS
SHORT_BASE_URL=https://short.example.com/r
FRONTEND_BASE_URL=https://app.example.com
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=5000
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_BSP_EXPORT_TIMEOUT=5000
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
OTEL_LOG_LEVEL=info
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production,service.version=0.0.1
JAEGER_MAX_TRACES=5000
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=3000
PERF_ENDPOINT_ENABLED=false
HTTP_BIND=0.0.0.0
HTTP_PORT=80
API_IMAGE=shortlink-api:local
MIGRATION_IMAGE=shortlink-migration:local
REDIS_CLUSTER_IMAGE=shortlink-redis-cluster:local
